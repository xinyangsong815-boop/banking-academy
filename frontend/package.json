{
  "name": "banking-academy-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.0.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.1"
  }
}
